<section class="hero">
  <h1 class="hero__title">함께 사면 더 싸게, 공구마켓</h1>
  <p class="hero__desc">이웃과 모여 좋은 상품을 저렴하게 구매해 보세요.</p>
</section>

<section class="section">
  <h2 class="section__title">진행 중인 공구 <span class="section__count"><%= groupBuys.length %></span></h2>

  <% if (groupBuys.length === 0) { %>
    <div class="empty">
      <p>지금 진행 중인 공구가 없어요.</p>
      <p class="empty__sub">새로운 공구가 열리면 이곳에서 가장 먼저 만나보세요.</p>
    </div>
  <% } else { %>
    <div class="card-grid">
      <% groupBuys.forEach((gb) => { %>
        <%- include('../partials/groupBuyCard', { gb }) %>
      <% }) %>
    </div>
  <% } %>
</section>
