<section class="form-page">
  <h1 class="form-page__title">회원가입</h1>

  <form method="POST" action="/signup" class="form" novalidate>
    <div class="field">
      <label for="email" class="field__label">이메일</label>
      <input type="email" id="email" name="email" class="field__input" value="<%= values.email || '' %>"
             autocomplete="email" required maxlength="255">
      <% if (errors.email) { %><p class="field__error"><%= errors.email %></p><% } %>
    </div>

    <div class="field">
      <label for="nickname" class="field__label">닉네임</label>
      <input type="text" id="nickname" name="nickname" class="field__input" value="<%= values.nickname || '' %>"
             autocomplete="nickname" required minlength="2" maxlength="20">
      <% if (errors.nickname) { %><p class="field__error"><%= errors.nickname %></p><% } %>
    </div>

    <div class="field">
      <label for="password" class="field__label">비밀번호</label>
      <input type="password" id="password" name="password" class="field__input"
             autocomplete="new-password" required minlength="8">
      <p class="field__help">영문과 숫자를 포함해 8자 이상</p>
      <% if (errors.password) { %><p class="field__error"><%= errors.password %></p><% } %>
    </div>

    <div class="field">
      <label for="passwordConfirm" class="field__label">비밀번호 확인</label>
      <input type="password" id="passwordConfirm" name="passwordConfirm" class="field__input"
             autocomplete="new-password" required>
      <% if (errors.passwordConfirm) { %><p class="field__error"><%= errors.passwordConfirm %></p><% } %>
    </div>

    <fieldset class="field">
      <legend class="field__label">회원 유형</legend>
      <label class="choice">
        <input type="radio" name="role" value="USER" <%= values.role !== 'HOST' ? 'checked' : '' %>>
        <span><strong>일반 회원</strong> · 공구에 참여해요</span>
      </label>
      <label class="choice">
        <input type="radio" name="role" value="HOST" <%= values.role === 'HOST' ? 'checked' : '' %>>
        <span><strong>공구장</strong> · 공구를 직접 열어요</span>
      </label>
    </fieldset>

    <button type="submit" class="btn btn--primary btn--block">가입하기</button>
  </form>

  <p class="form-page__alt">이미 회원이신가요? <a href="/login">로그인</a></p>
</section>
